# Доступ к Cloudflare. Реальные значения кладутся в .env рядом —
# он закрыт .gitignore и в репозиторий не попадает.
#
# Токен создаётся здесь:
#   dash.cloudflare.com → My Profile → API Tokens → Create Token
# Нужен именно API Token с ограниченными правами, НЕ Global API Key:
# токен можно отозвать отдельно, не трогая остальное.

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
